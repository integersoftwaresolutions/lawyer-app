NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/lawyer_marketplace

CLIENT_ORIGIN=http://localhost:5173
# Optional — defaults to CLIENT_ORIGIN; used for links in emails
APP_BASE_URL=http://localhost:5173

# Email via Resend HTTPS (https://resend.com). SMTP is blocked on Render.
# Leave RESEND_API_KEY empty locally to log emails to the console.
RESEND_API_KEY=
EMAIL_FROM=beth.t@example.com
EMAIL_FROM_NAME=Adal AI

# Public "Request a demo" form — sales notification inbox
LEADS_INBOX=integersoftwaresolutions@gmail.com

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Reminder job interval (ms) — default 5 minutes
REMINDER_JOB_INTERVAL_MS=300000

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Phase 2 — AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REQUEST_TIMEOUT_MS=60000
AI_DAILY_REQUEST_LIMIT=50
ENCRYPTION_KEY=

# Phase 2 — RAG / Vector store (Pinecone)
# Create a Serverless index (cosine, 1536 dims for text-embedding-3-small) at https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=lawyer-app-rag
PINECONE_CASE_LAW_NAMESPACE=case-law
RAG_EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=100
RAG_PRIVATE_DOCUMENT_CHUNK_SIZE_TOKENS=400
RAG_PRIVATE_DOCUMENT_CHUNK_OVERLAP_TOKENS=80
RAG_TOP_K=6
# Conservative floor for the shared case-law corpus.
RAG_MIN_SCORE=0.35
# Private documents are isolated per lawyer, so a lower semantic floor is safe.
# Exact-term lexical retrieval is also used as a fallback for factual questions.
RAG_PRIVATE_DOCUMENT_MIN_SCORE=0.18

# Phase 3 — Billing / Stripe (leave empty in local to skip live Checkout; firm create falls back to manual Firm grant)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_FIRM_MONTHLY=
BILLING_TRIAL_DAYS=14
BILLING_PAST_DUE_GRACE_DAYS=3
BILLING_RECONCILE_ENABLED=true
BILLING_JOB_INTERVAL_MS=3600000
# Marketing / UI display prices (Stripe Dashboard owns real charges)
BILLING_DISPLAY_PRICE_PRO=29
BILLING_DISPLAY_PRICE_FIRM=99
BILLING_DISPLAY_CURRENCY=usd
