NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/lawyer_marketplace

CLIENT_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Phase 2 — AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REQUEST_TIMEOUT_MS=60000
AI_DAILY_REQUEST_LIMIT=50
ENCRYPTION_KEY=

# Phase 2 — RAG / Vector store (Pinecone)
# Create a Serverless index (cosine, 1536 dims for text-embedding-3-small) at https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=lawyer-app-rag
PINECONE_CASE_LAW_NAMESPACE=case-law
RAG_EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=100
RAG_TOP_K=6
# Cosine similarity floor below which retrieved chunks are ignored.
# 0.35 is a sane default for text-embedding-3-small — relevant matches
# typically score 0.40–0.65 with that model. Raise toward 0.5 if the
# assistant cites loosely related judgments; lower if it's too cautious.
RAG_MIN_SCORE=0.35
